    { "id": "drag-mixed-selection", "type": "drag", "target": { "strategy": "automation-id", "value": "viewer-container" }, "button": "left", "from": { "x": 0.59, "y": 0.50 }, "to": { "x": 0.65, "y": 0.50 }, "steps": 8, "completion": { "kind": "entity-rect-deltas", "entities": [{ "entityId": "obj_line_1", "operator": "stationary", "toleranceWorld": 0.5 }, { "entityId": "obj_line_2", "operator": "moved", "toleranceWorld": 5 }], "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "undo-mixed-selection-drag", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Z", "completion": { "kind": "entity-rect-deltas", "entities": [{ "entityId": "obj_line_1", "operator": "stationary", "toleranceWorld": 0.5 }, { "entityId": "obj_line_2", "operator": "moved", "toleranceWorld": 5 }], "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "redo-mixed-selection-drag", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Y", "completion": { "kind": "entity-rect-deltas", "entities": [{ "entityId": "obj_line_1", "operator": "stationary", "toleranceWorld": 0.5 }, { "entityId": "obj_line_2", "operator": "moved", "toleranceWorld": 5 }], "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "clear-mixed-selection", "type": "click", "target": { "strategy": "world-geometry", "value": "page-background" }, "button": "left", "completion": { "kind": "dom-count", "selector": "[data-layer=\"editor-overlay\"] > *", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 30000 },
