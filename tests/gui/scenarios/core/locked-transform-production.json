    { "id": "unlock-first-arrow", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Unlock", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "quiescent", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "select-two-editable-arrows", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+A", "completion": { "kind": "dom-count", "selector": "[data-layer=\"editor-overlay\"] > *", "operator": "gte", "value": 2, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "drag-two-editable-arrows", "type": "drag", "target": { "strategy": "automation-id", "value": "viewer-container" }, "button": "left", "from": { "x": 0.62, "y": 0.50 }, "to": { "x": 0.68, "y": 0.50 }, "steps": 8, "completion": { "kind": "entity-rect-deltas", "entities": [{ "entityId": "obj_line_1", "operator": "moved", "toleranceWorld": 5 }, { "entityId": "obj_line_2", "operator": "moved", "toleranceWorld": 5 }], "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "undo-two-editable-arrow-drag", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Z", "completion": { "kind": "entity-rect-deltas", "entities": [{ "entityId": "obj_line_1", "operator": "moved", "toleranceWorld": 5 }, { "entityId": "obj_line_2", "operator": "moved", "toleranceWorld": 5 }], "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "redo-two-editable-arrow-drag", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Y", "completion": { "kind": "entity-rect-deltas", "entities": [{ "entityId": "obj_line_1", "operator": "moved", "toleranceWorld": 5 }, { "entityId": "obj_line_2", "operator": "moved", "toleranceWorld": 5 }], "timeoutMs": 8000 }, "budgetMs": 30000 }
  ],
  "oracles": [
    { "id": "both-arrows-remain", "kind": "dom-distinct-count", "selector": "[data-role=\"document-graphic\"][data-object-id]", "attribute": "data-object-id", "operator": "eq", "value": 2 },
    { "id": "context-menu-is-closed", "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden])", "operator": "eq", "value": 0 },
    { "id": "no-console-errors", "kind": "no-unexpected-diagnostics" }
  ],
  "expectedDiagnostics": [],
  "coverage": {
    "classification": "real-user-path",
    "features": ["editor.arrow.draw", "editor.selection.region", "editor.selection.select-all", "editor.object.lock", "editor.context-menu", "editor.selection.transform-partial", "editor.history.undo-redo", "desktop.production"],
    "objectTypes": ["arrow"],
    "cardinalities": ["1", "2"],
    "states": ["unlocked", "locked", "mixed-applicability", "moved", "stationary", "undone", "redone", "unlocked-again"],
