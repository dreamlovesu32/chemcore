{
  "schema": "chemsema.gui.scenario.v1",
  "id": "core.selection.locked-transform.production",
  "title": "Keep locked members stationary during mixed transforms and restore movement after Unlock",
  "risk": "critical",
  "owner": "editor-core",
  "originatingDefect": "Selection transforms ignored the CCJS locked editing contract and moved locked objects.",
  "capabilities": [
    "gui.public-input",
    "editor.arrow.draw",
    "editor.selection.region",
    "editor.selection.select-all",
    "editor.object.lock",
    "editor.context-menu",
    "editor.selection.transform-partial",
    "editor.history.undo-redo",
    "desktop.production"
