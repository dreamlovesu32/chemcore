{
  "schema": "chemsema.gui.scenario.v1",
  "id": "core.text.existing-edit-history.production",
  "title": "Edit existing styled text, prove exact history, cancel a replacement, and verify persistence",
  "risk": "critical",
  "owner": "editor-core",
  "originatingDefect": "Existing-text editing, exact content transitions, style preservation, and cancel behavior were left only in a legacy browser script without isolated production input or saved-file evidence.",
  "capabilities": ["gui.public-input", "editor.text.create", "editor.text.properties", "editor.text.edit-existing", "editor.context-menu", "editor.history.undo-redo", "document.save-as", "oracle.document-file", "desktop.production"],
  "drivers": ["production-black-box"],
  "profile": { "pool": "interactive-isolated-worker", "viewport": { "width": 1028, "height": 779 }, "dpi": 96, "locale": "zh-CN", "theme": "light", "runtime": "production" },
  "seed": 19,
  "actions": [
    { "id": "activate-text-tool", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Text", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "dom-count", "selector": "button[data-tool=\"text\"].is-active", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "open-new-text-editor", "type": "click", "target": { "strategy": "automation-id", "value": "viewer-container" }, "at": { "x": 0.44, "y": 0.42 }, "completion": { "kind": "dom-count", "selector": ".text-editor-input", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "type-original-text", "type": "text", "target": { "strategy": "role", "value": "textbox", "name": "text editor input" }, "text": "Original text", "completion": { "kind": "dom-text", "selector": ".text-editor-display", "text": "Original text", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "commit-original-text", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Box selection", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "dom-text", "selector": "[data-role=\"document-text\"][data-object-id=\"obj_text_1\"]", "text": "Original text", "timeoutMs": 8000 }, "budgetMs": 30000 },

    { "id": "open-original-style-menu", "type": "click", "target": { "strategy": "entity-id", "value": "obj_text_1" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-command=\"text-style\"][data-canvas-context-value=\"bold:on\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "expand-original-style-menu", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Style", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"Style\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "make-original-bold", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Bold", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": "[data-role=\"document-text\"][data-object-id=\"obj_text_1\"] > tspan[font-weight=\"700\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },

    { "id": "reactivate-text-tool", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Text", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "dom-count", "selector": "button[data-tool=\"text\"].is-active", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "open-existing-text-editor", "type": "click", "target": { "strategy": "entity-id", "value": "obj_text_1" }, "completion": { "kind": "dom-text", "selector": ".text-editor-display", "text": "Original text", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "select-existing-text", "type": "key", "target": { "strategy": "role", "value": "textbox", "name": "text editor input" }, "key": "Control+A", "completion": { "kind": "dom-text", "selector": ".text-editor-display", "text": "Original text", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "replace-existing-text", "type": "text", "target": { "strategy": "role", "value": "textbox", "name": "text editor input" }, "text": "Edited text", "completion": { "kind": "dom-text", "selector": ".text-editor-display", "text": "Edited text", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "commit-edited-text", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Box selection", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "dom-text", "selector": "[data-role=\"document-text\"][data-object-id=\"obj_text_1\"]", "text": "Edited text", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "undo-existing-text-edit", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Z", "completion": { "kind": "dom-text", "selector": "[data-role=\"document-text\"][data-object-id=\"obj_text_1\"]", "text": "Original text", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "redo-existing-text-edit", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Y", "completion": { "kind": "dom-text", "selector": "[data-role=\"document-text\"][data-object-id=\"obj_text_1\"]", "text": "Edited text", "timeoutMs": 8000 }, "budgetMs": 30000 },

    { "id": "reactivate-text-tool-for-cancel", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Text", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "dom-count", "selector": "button[data-tool=\"text\"].is-active", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "reopen-edited-text", "type": "click", "target": { "strategy": "entity-id", "value": "obj_text_1" }, "completion": { "kind": "dom-text", "selector": ".text-editor-display", "text": "Edited text", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "select-edited-text", "type": "key", "target": { "strategy": "role", "value": "textbox", "name": "text editor input" }, "key": "Control+A", "completion": { "kind": "dom-text", "selector": ".text-editor-display", "text": "Edited text", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "type-discarded-replacement", "type": "text", "target": { "strategy": "role", "value": "textbox", "name": "text editor input" }, "text": "Discarded text", "completion": { "kind": "dom-text", "selector": ".text-editor-display", "text": "Discarded text", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "cancel-discarded-replacement", "type": "key", "target": { "strategy": "role", "value": "textbox", "name": "text editor input" }, "key": "Escape", "completion": { "kind": "dom-text", "selector": "[data-role=\"document-text\"][data-object-id=\"obj_text_1\"]", "text": "Edited text", "timeoutMs": 8000 }, "budgetMs": 30000 },

    { "id": "open-save-as-dialog", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Save as" }, "completion": { "kind": "uia-visible", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "timeoutMs": 15000 }, "budgetMs": 30000 },
    { "id": "focus-save-filename", "type": "click", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "select-save-filename", "type": "key", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "key": "Control+A", "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "type-save-path", "type": "text", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "textSource": "document-output-path", "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "confirm-save", "type": "key", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "key": "Enter", "completion": { "kind": "document-saved", "timeoutMs": 30000 }, "budgetMs": 90000 }
  ],
  "oracles": [
    { "id": "one-edited-text-object-remains", "kind": "dom-distinct-count", "selector": "[data-role=\"document-text\"][data-object-id]", "attribute": "data-object-id", "operator": "eq", "value": 1 },
    { "id": "saved-existing-text-edit", "kind": "document-text-properties", "expected": [
      { "id": "obj_text_1", "text": "Edited text", "bold": true }
    ] },
    { "id": "no-console-errors", "kind": "no-unexpected-diagnostics" }
  ],
  "expectedDiagnostics": [],
  "coverage": {
    "classification": "real-user-path",
    "features": ["editor.text.create", "editor.text.properties", "editor.text.edit-existing", "editor.context-menu", "editor.history.undo-redo", "document.save-as", "oracle.document-file", "desktop.production"],
    "objectTypes": ["text"],
    "cardinalities": ["1"],
    "states": ["editing", "committed", "styled", "existing-edit", "selected-all-text", "replaced", "undone", "redone", "cancelled", "saved-document"],
    "inputModes": ["mouse", "right-mouse", "keyboard", "text", "native-dialog"],
    "properties": ["text.content", "text.bold"],
    "persistenceBoundaries": ["runtime", "history", "cancel", "filesystem", "native-dialog"]
  }
}
