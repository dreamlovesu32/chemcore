{
  "schema": "chemsema.gui.scenario.v1",
  "id": "core.history.undo-redo-bond.production",
  "title": "Undo and redo a drawn bond through guarded production keyboard input",
  "risk": "critical",
  "owner": "editor-core",
  "originatingDefect": null,
  "capabilities": ["gui.public-input", "editor.bond.draw", "editor.history.undo-redo", "desktop.production"],
  "drivers": ["production-black-box"],
  "profile": { "pool": "interactive-isolated-worker", "viewport": { "width": 1028, "height": 779 }, "dpi": 96, "locale": "zh-CN", "theme": "light", "runtime": "production" },
  "seed": 2,
  "actions": [
    { "id": "activate-bond-tool", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Single bond", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "actionable", "timeoutMs": 12000 }, "budgetMs": 12000 },
    { "id": "draw-single-bond", "type": "drag", "target": { "strategy": "automation-id", "value": "viewer-container" }, "button": "left", "from": { "x": 0.43, "y": 0.5 }, "to": { "x": 0.53, "y": 0.5 }, "steps": 8, "completion": { "kind": "dom-count", "selector": "[data-bond-id]", "operator": "eq", "value": 1, "timeoutMs": 12000 }, "budgetMs": 12000 },
    { "id": "undo-bond", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Z", "completion": { "kind": "dom-count", "selector": "[data-bond-id]", "operator": "eq", "value": 0, "timeoutMs": 12000 }, "budgetMs": 12000 },
    { "id": "redo-bond", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Y", "completion": { "kind": "dom-count", "selector": "[data-bond-id]", "operator": "eq", "value": 1, "timeoutMs": 12000 }, "budgetMs": 12000 }
  ],
  "oracles": [
    { "id": "redone-bond-exists", "kind": "dom-count", "selector": "[data-bond-id]", "operator": "eq", "value": 1 },
    { "id": "no-console-errors", "kind": "no-unexpected-diagnostics" }
  ],
  "expectedDiagnostics": [],
  "coverage": { "classification": "real-user-path", "features": ["editor.bond.draw", "editor.history.undo-redo", "desktop.production"], "objectTypes": ["bond", "molecule"], "cardinalities": ["0", "1"], "states": ["blank-document", "drawn", "undone", "redone"], "inputModes": ["mouse", "keyboard"], "properties": ["bond.order.single"], "persistenceBoundaries": ["runtime", "undo-stack"] }
}
