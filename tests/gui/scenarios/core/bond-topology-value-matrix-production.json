  "expectedDiagnostics": [],
  "coverage": {
    "classification": "real-user-path",
    "features": ["editor.bond.draw", "editor.bond.topology", "editor.context-menu", "document.save-as", "oracle.document-file", "desktop.production"],
    "objectTypes": ["bond", "atom", "molecule"],
