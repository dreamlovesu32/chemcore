{
  "schema": "chemsema.gui.scenario.v1",
  "id": "core.document.save-open-roundtrip.production",
  "title": "Save, independently validate, reopen, and continue editing a CCJS document through native dialogs",
  "risk": "critical",
  "owner": "document-io",
