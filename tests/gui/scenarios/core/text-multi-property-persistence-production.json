{
  "schema": "chemsema.gui.scenario.v1",
  "id": "core.text.multi-property-persistence.production",
  "title": "Create two text objects with real typing, batch-edit public properties, and verify persistence",
  "risk": "critical",
  "owner": "editor-core",
  "originatingDefect": "The production GUI platform could send only generated save paths, so real text entry and persisted multi-text property behavior had no auditable public-input evidence.",
  "capabilities": ["gui.public-input", "editor.text.create", "editor.text.properties", "editor.selection.select-all", "editor.context-menu", "editor.history.undo-redo", "document.save-as", "oracle.document-file", "desktop.production"],
  "drivers": ["production-black-box"],
  "profile": { "pool": "interactive-isolated-worker", "viewport": { "width": 1028, "height": 779 }, "dpi": 96, "locale": "zh-CN", "theme": "light", "runtime": "production" },
  "seed": 17,
  "actions": [
    { "id": "activate-text-tool-first", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Text", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "dom-count", "selector": "button[data-tool=\"text\"].is-active", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "open-first-text-editor", "type": "click", "target": { "strategy": "automation-id", "value": "viewer-container" }, "at": { "x": 0.32, "y": 0.34 }, "completion": { "kind": "dom-count", "selector": ".text-editor-input", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "type-first-text", "type": "text", "target": { "strategy": "role", "value": "textbox", "name": "text editor input" }, "text": "ChemSema H2O", "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "commit-first-text", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Box selection", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "dom-distinct-count", "selector": "[data-role=\"document-text\"][data-object-id]", "attribute": "data-object-id", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },

    { "id": "activate-text-tool-second", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Text", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "dom-count", "selector": "button[data-tool=\"text\"].is-active", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "open-second-text-editor", "type": "click", "target": { "strategy": "automation-id", "value": "viewer-container" }, "button": "left", "at": { "x": 0.68, "y": 0.58 }, "completion": { "kind": "dom-count", "selector": ".text-editor-input", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "type-second-text", "type": "text", "target": { "strategy": "role", "value": "textbox", "name": "text editor input" }, "text": "Second text", "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "commit-second-text", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Box selection", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "dom-distinct-count", "selector": "[data-role=\"document-text\"][data-object-id]", "attribute": "data-object-id", "operator": "eq", "value": 2, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "select-both-text-objects", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+A", "completion": { "kind": "dom-count", "selector": "[data-layer=\"editor-overlay\"] > *", "operator": "gte", "value": 2, "timeoutMs": 8000 }, "budgetMs": 30000 },

    { "id": "open-text-style-menu", "type": "click", "target": { "strategy": "entity-id", "value": "obj_text_1" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-command=\"text-style\"][data-canvas-context-value=\"bold:on\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "expand-text-style-menu", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Style", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"Style\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "make-both-text-bold", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Bold", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden])", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 30000 },

    { "id": "open-text-alignment-menu", "type": "click", "target": { "strategy": "entity-id", "value": "obj_text_1" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-command=\"text-style\"][data-canvas-context-value=\"bold:off\"][aria-checked=\"true\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "expand-text-alignment-menu", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Alignment", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"Alignment\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "center-both-text-objects", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Center", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden])", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 30000 },

    { "id": "open-text-size-menu", "type": "click", "target": { "strategy": "entity-id", "value": "obj_text_1" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-command=\"text-style\"][data-canvas-context-value=\"align:center\"][aria-checked=\"true\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "expand-text-size-menu", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Size", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"Size\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "set-both-text-size-18", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "18", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden])", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 30000 },

    { "id": "open-text-color-menu", "type": "click", "target": { "strategy": "entity-id", "value": "obj_text_1" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-command=\"text-style\"][data-canvas-context-value=\"font-size:18\"][aria-checked=\"true\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "expand-text-color-menu", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Color", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"Color\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "make-both-text-blue", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Blue", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden])", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "undo-batch-text-color", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Z", "completion": { "kind": "dom-count", "selector": "[data-role=\"document-text\"] [fill=\"#000000\"]", "operator": "gte", "value": 2, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "redo-batch-text-color", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Y", "completion": { "kind": "dom-count", "selector": "[data-role=\"document-text\"] [fill=\"#0000ff\"]", "operator": "gte", "value": 2, "timeoutMs": 8000 }, "budgetMs": 30000 },

    { "id": "open-save-as-dialog", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Save as" }, "completion": { "kind": "uia-visible", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "timeoutMs": 15000 }, "budgetMs": 30000 },
    { "id": "focus-save-filename", "type": "click", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "select-save-filename", "type": "key", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "key": "Control+A", "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "type-save-path", "type": "text", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "textSource": "document-output-path", "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "confirm-save", "type": "key", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "key": "Enter", "completion": { "kind": "document-saved", "timeoutMs": 30000 }, "budgetMs": 90000 }
  ],
  "oracles": [
    { "id": "two-text-objects-remain", "kind": "dom-distinct-count", "selector": "[data-role=\"document-text\"][data-object-id]", "attribute": "data-object-id", "operator": "eq", "value": 2 },
    { "id": "saved-text-property-matrix", "kind": "document-text-properties", "expected": [
      { "id": "obj_text_1", "text": "ChemSema H2O", "fontFamily": "Arial", "fontSize": 18, "align": "center", "bold": true, "fill": "#0000ff" },
      { "id": "obj_text_2", "text": "Second text", "fontFamily": "Arial", "fontSize": 18, "align": "center", "bold": true, "fill": "#0000ff" }
    ] },
    { "id": "no-console-errors", "kind": "no-unexpected-diagnostics" }
  ],
  "expectedDiagnostics": [],
  "coverage": {
    "classification": "real-user-path",
    "features": ["editor.text.create", "editor.text.properties", "editor.selection.select-all", "editor.context-menu", "editor.history.undo-redo", "document.save-as", "oracle.document-file", "desktop.production"],
    "objectTypes": ["text"],
    "cardinalities": ["1", "2"],
    "states": ["editing", "committed", "selected", "bold", "centered", "size-18", "blue", "saved-document"],
    "inputModes": ["mouse", "right-mouse", "keyboard", "text", "native-dialog"],
    "properties": ["text.content", "text.font-family", "text.font-size", "text.alignment", "text.bold", "text.color"],
    "persistenceBoundaries": ["runtime", "history", "filesystem", "native-dialog"]
  }
}
