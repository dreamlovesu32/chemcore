{
  "schema": "chemsema.gui.scenario.v1",
  "id": "core.atom.minus-symbol-attachment-persistence.production",
  "title": "Attach the public uncircled minus symbol to oxygen and persist alkoxide semantics",
  "risk": "critical",
  "owner": "editor-core",
  "originatingDefect": "Circle-minus attachment evidence did not prove that the distinct public uncircled Minus control applies the same -1 chemistry while persisting its own exact symbol kind and atom link.",
