    "properties": ["atom.element", "atom.atomic-number", "atom.charge", "atom.num-hydrogens", "atom.label-text", "symbol.kind", "symbol.chemical-role", "symbol.charge-delta", "symbol.radical-delta", "symbol.attached-atom", "symbol.attachment-source"],
