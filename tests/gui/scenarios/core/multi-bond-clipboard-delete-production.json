{
  "schema": "chemsema.gui.scenario.v1",
  "id": "core.selection.clipboard-delete-multi-bond.production",
  "title": "Select, copy, paste, delete, undo, and redo multiple bonds through guarded production input",
  "risk": "critical",
  "owner": "editor-core",
  "originatingDefect": null,
  "capabilities": [
    "gui.public-input",
    "editor.bond.draw",
    "editor.selection.select-all",
    "editor.clipboard.copy-paste",
    "editor.selection.delete",
    "editor.history.undo-redo",
    "desktop.production"
  ],
  "drivers": ["production-black-box"],
  "profile": { "pool": "interactive-isolated-worker", "viewport": { "width": 1028, "height": 779 }, "dpi": 96, "locale": "zh-CN", "theme": "light", "runtime": "production" },
  "seed": 3,
  "actions": [
    { "id": "activate-bond-tool", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Single bond", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "draw-first-bond", "type": "drag", "target": { "strategy": "automation-id", "value": "viewer-container" }, "button": "left", "from": { "x": 0.34, "y": 0.42 }, "to": { "x": 0.44, "y": 0.42 }, "steps": 8, "completion": { "kind": "dom-count", "selector": "[data-bond-id]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "draw-second-bond", "type": "drag", "target": { "strategy": "automation-id", "value": "viewer-container" }, "button": "left", "from": { "x": 0.58, "y": 0.58 }, "to": { "x": 0.68, "y": 0.58 }, "steps": 8, "completion": { "kind": "dom-count", "selector": "[data-bond-id]", "operator": "eq", "value": 2, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "activate-box-selection", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Box selection", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "dom-count", "selector": "button[data-tool=\"select\"].is-active", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "select-all", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+A", "completion": { "kind": "dom-count", "selector": "[data-layer=\"editor-overlay\"] > *", "operator": "gte", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "copy-selection", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+C", "completion": { "kind": "actionable", "timeoutMs": 20000 }, "budgetMs": 30000 },
    { "id": "paste-selection", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+V", "completion": { "kind": "dom-count", "selector": "[data-bond-id]", "operator": "eq", "value": 4, "timeoutMs": 20000 }, "budgetMs": 30000 },
    { "id": "select-all-after-paste", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+A", "completion": { "kind": "dom-count", "selector": "[data-layer=\"editor-overlay\"] > *", "operator": "gte", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "delete-all", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Delete", "completion": { "kind": "dom-count", "selector": "[data-bond-id]", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "undo-delete", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Z", "completion": { "kind": "dom-count", "selector": "[data-bond-id]", "operator": "eq", "value": 4, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "redo-delete", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Y", "completion": { "kind": "dom-count", "selector": "[data-bond-id]", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 12000 }
  ],
  "oracles": [
    { "id": "redo-leaves-document-empty", "kind": "dom-count", "selector": "[data-bond-id]", "operator": "eq", "value": 0 },
    { "id": "no-stale-selection-overlay", "kind": "dom-count", "selector": "[data-layer=\"editor-overlay\"] > *", "operator": "eq", "value": 0 },
    { "id": "no-console-errors", "kind": "no-unexpected-diagnostics" }
  ],
  "expectedDiagnostics": [],
  "coverage": {
    "classification": "real-user-path",
    "features": ["editor.bond.draw", "editor.selection.select-all", "editor.clipboard.copy-paste", "editor.selection.delete", "editor.history.undo-redo", "desktop.production"],
    "objectTypes": ["bond", "molecule"],
    "cardinalities": ["0", "1", "2", "many"],
    "states": ["blank-document", "multi-object", "selected", "copied", "pasted", "deleted", "undone", "redone"],
    "inputModes": ["mouse", "keyboard"],
    "properties": ["bond.order.single"],
    "persistenceBoundaries": ["runtime", "system-clipboard", "undo-stack"]
  }
}
