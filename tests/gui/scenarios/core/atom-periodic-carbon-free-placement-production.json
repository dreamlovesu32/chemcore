{
  "schema": "chemsema.gui.scenario.v1",
  "id": "core.atom.periodic-carbon-free-placement.production",
  "title": "Place carbon directly through the public Element palette and persist methane semantics",
  "risk": "critical",
  "owner": "editor-core",
  "originatingDefect": "The existing periodic matrix never explicitly selects Carbon, so it cannot kill a missing or mis-mapped C button, an accidental bond-tool fallback, a hidden standalone node, or incorrect methane implicit-hydrogen semantics.",
  "capabilities": ["gui.public-input", "editor.atom.element", "document.save-as", "oracle.document-file", "desktop.production"],
  "drivers": ["production-black-box"],
  "profile": { "pool": "interactive-isolated-worker", "viewport": { "width": 1028, "height": 779 }, "dpi": 96, "locale": "zh-CN", "theme": "light", "runtime": "production" },
  "seed": 6,
  "actions": [
    { "id": "open-element-palette-for-carbon", "type": "click", "target": { "strategy": "selector", "value": ".quick-palette-toggle-element[data-quick-palette-mode=\"element\"]" }, "completion": { "kind": "dom-count", "selector": ".quick-palette.is-open[data-mode=\"element\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "choose-carbon", "type": "click", "target": { "strategy": "selector", "value": ".periodic-element-button[data-element-symbol=\"C\"][data-element-atomic-number=\"6\"]" }, "completion": { "kind": "dom-count", "selector": ".quick-palette:not(.is-open)[data-mode=\"element\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "place-carbon", "type": "click", "target": { "strategy": "automation-id", "value": "viewer-container" }, "button": "left", "at": { "x": 0.5, "y": 0.5 }, "completion": { "kind": "dom-distinct-count", "selector": "[data-node-id=\"n_1\"]", "attribute": "data-node-id", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "open-save-as-dialog", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Save as" }, "completion": { "kind": "uia-visible", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "timeoutMs": 15000 }, "budgetMs": 30000 },
    { "id": "focus-save-filename", "type": "click", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "select-save-filename", "type": "key", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "key": "Control+A", "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "type-save-path", "type": "text", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "textSource": "document-output-path", "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "confirm-save", "type": "key", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "key": "Enter", "completion": { "kind": "document-saved", "timeoutMs": 30000 }, "budgetMs": 90000 }
  ],
  "oracles": [
    { "id": "one-carbon-atom-rendered", "kind": "dom-distinct-count", "selector": "[data-node-id]", "attribute": "data-node-id", "operator": "eq", "value": 1 },
    { "id": "saved-carbon-counts", "kind": "document-counts", "expected": { "nodes": 1, "bonds": 0, "molecules": 1, "objects": 1 } },
    { "id": "saved-carbon-semantics", "kind": "document-node-properties", "expected": [
      { "id": "n_1", "element": "C", "atomicNumber": 6, "charge": 0, "numHydrogens": 4, "labelText": "CH4", "labelSourceText": "CH4" }
    ] },
    { "id": "no-console-errors", "kind": "no-unexpected-diagnostics" }
  ],
  "expectedDiagnostics": [],
  "coverage": {
    "classification": "real-user-path",
    "features": ["editor.atom.element", "editor.atom.free-placement", "editor.atom.label", "document.save-as", "oracle.document-file", "desktop.production"],
    "objectTypes": ["atom", "molecule"],
    "cardinalities": ["1"],
    "states": ["blank-document", "periodic-palette-open", "carbon", "saved-document"],
    "inputModes": ["mouse", "keyboard", "native-dialog"],
    "properties": ["atom.element", "atom.atomic-number", "atom.charge", "atom.identity", "atom.free-placement", "atom.implicit-hydrogens"],
    "persistenceBoundaries": ["runtime", "filesystem", "native-dialog"]
  }
}
