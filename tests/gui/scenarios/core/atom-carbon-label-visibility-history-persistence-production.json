{
  "schema": "chemsema.gui.scenario.v1",
  "id": "core.atom.carbon-label-visibility-history-persistence.production",
  "title": "Toggle terminal and nonterminal Carbon labels, verify checked state and history, and persist explicit visibility",
  "risk": "critical",
  "owner": "editor-core",
  "originatingDefect": "The first physical cell created disconnected bonds and attempted to locate hidden implicit Carbon through a nonexistent data-node-id primitive; it also exposed hard-coded unchecked Carbon-label menu values. The second cell expanded Atom Properties even though Carbon-label commands live in Atom Query. The third cell treated a closed rendered bond polygon's perimeter end as its logical endpoint and clicked the terminal-label clipping edge instead of the shared Carbon.",
  "capabilities": ["gui.public-input", "editor.chain.draw", "editor.atom.carbon-label-visibility", "editor.context-menu", "editor.history.undo-redo", "document.save-as", "oracle.document-file", "desktop.production"],
  "drivers": ["production-black-box"],
  "profile": { "pool": "interactive-isolated-worker", "viewport": { "width": 1028, "height": 779 }, "dpi": 96, "locale": "zh-CN", "theme": "light", "runtime": "production" },
  "seed": 32,
  "actions": [
    { "id": "activate-chain-tool", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Chain", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "dom-count", "selector": "button[data-tool=\"chain\"].is-active", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "draw-connected-two-bond-carbon-chain", "type": "drag", "target": { "strategy": "automation-id", "value": "viewer-container" }, "button": "left", "from": { "x": 0.28, "y": 0.46 }, "to": { "x": 0.3525, "y": 0.46 }, "steps": 8, "completion": { "kind": "dom-distinct-count", "selector": "[data-bond-id]", "attribute": "data-bond-id", "operator": "eq", "value": 2, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "activate-box-selection", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Box selection", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "dom-count", "selector": "button[data-tool=\"select\"].is-active", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "clear-created-chain-selection", "type": "click", "target": { "strategy": "world-geometry", "value": "page-background" }, "button": "left", "completion": { "kind": "dom-count", "selector": "[data-layer=\"editor-overlay\"] > *", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 30000 },

    { "id": "open-default-terminal-label-menu", "type": "click", "target": { "strategy": "bond-endpoint", "value": "b_4:start" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-command=\"atom-property\"][data-canvas-context-value=\"show-terminal-carbon-label:false\"][aria-checked=\"true\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "expand-atom-query-for-terminal-show", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Atom Query", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"Atom Query\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "show-terminal-carbon-label", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Show Terminal Carbon Labels", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-text", "selector": "text[data-node-id=\"n_1\"]", "text": "H3C", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "open-shown-terminal-label-menu", "type": "click", "target": { "strategy": "selector", "value": "[data-node-id=\"n_1\"]" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-value=\"show-terminal-carbon-label:true\"][aria-checked=\"true\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "expand-atom-query-for-terminal-hide", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Atom Query", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"Atom Query\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "hide-terminal-carbon-label", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Hide Terminal Carbon Labels", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": "text[data-node-id=\"n_1\"]", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "undo-terminal-hide", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Z", "completion": { "kind": "dom-text", "selector": "text[data-node-id=\"n_1\"]", "text": "H3C", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "redo-terminal-hide", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Y", "completion": { "kind": "dom-count", "selector": "text[data-node-id=\"n_1\"]", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "undo-terminal-hide-for-final", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Z", "completion": { "kind": "dom-text", "selector": "text[data-node-id=\"n_1\"]", "text": "H3C", "timeoutMs": 8000 }, "budgetMs": 30000 },

    { "id": "open-default-nonterminal-label-menu", "type": "click", "target": { "strategy": "bond-endpoint", "value": "b_4:end" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-value=\"show-non-terminal-carbon-label:false\"][aria-checked=\"true\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "expand-atom-query-for-nonterminal-show", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Atom Query", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"Atom Query\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "show-nonterminal-carbon-label", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Show Nonterminal Carbon Labels", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": "text[data-node-id=\"n_2\"]", "operator": "eq", "value": 2, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "open-shown-nonterminal-label-menu", "type": "click", "target": { "strategy": "selector", "value": "text[data-node-id=\"n_2\"]:has(> tspan:only-child)" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-value=\"show-non-terminal-carbon-label:true\"][aria-checked=\"true\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "expand-atom-query-for-nonterminal-hide", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Atom Query", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"Atom Query\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "hide-nonterminal-carbon-label", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Hide Nonterminal Carbon Labels", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": "text[data-node-id=\"n_2\"]", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "undo-nonterminal-hide", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Z", "completion": { "kind": "dom-count", "selector": "text[data-node-id=\"n_2\"]", "operator": "eq", "value": 2, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "redo-nonterminal-hide", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Y", "completion": { "kind": "dom-count", "selector": "text[data-node-id=\"n_2\"]", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "undo-nonterminal-hide-for-final", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+Z", "completion": { "kind": "dom-count", "selector": "text[data-node-id=\"n_2\"]", "operator": "eq", "value": 2, "timeoutMs": 8000 }, "budgetMs": 30000 },

    { "id": "open-save-as-dialog", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Save as" }, "completion": { "kind": "uia-visible", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "timeoutMs": 15000 }, "budgetMs": 30000 },
    { "id": "focus-save-filename", "type": "click", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "select-save-filename", "type": "key", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "key": "Control+A", "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "type-save-path", "type": "text", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "textSource": "document-output-path", "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 30000 },
    { "id": "confirm-save", "type": "key", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "key": "Enter", "completion": { "kind": "document-saved", "timeoutMs": 30000 }, "budgetMs": 90000 }
  ],
  "oracles": [
    { "id": "terminal-and-nonterminal-carbon-labels-visible", "kind": "dom-count", "selector": "text[data-node-id=\"n_1\"], text[data-node-id=\"n_2\"]", "operator": "eq", "value": 3 },
    { "id": "saved-carbon-label-topology-counts", "kind": "document-counts", "expected": { "nodes": 3, "bonds": 2, "molecules": 1, "objects": 1 } },
    { "id": "saved-explicit-carbon-label-visibility-semantics", "kind": "document-node-properties", "expected": [
      { "id": "n_1", "element": "C", "atomicNumber": 6, "charge": 0, "numHydrogens": 3, "showTerminalCarbonLabel": true, "showNonTerminalCarbonLabel": null, "labelText": "H3C", "labelSourceText": "CH3" },
      { "id": "n_2", "element": "C", "atomicNumber": 6, "charge": 0, "numHydrogens": 2, "showTerminalCarbonLabel": null, "showNonTerminalCarbonLabel": true, "labelText": "C\nH2", "labelSourceText": "CH2" }
    ] },
    { "id": "no-console-errors", "kind": "no-unexpected-diagnostics" }
  ],
  "expectedDiagnostics": [],
  "coverage": {
    "classification": "real-user-path",
    "features": ["editor.chain.draw", "editor.atom.carbon-label-visibility", "editor.context-menu", "editor.history.undo-redo", "document.save-as", "oracle.document-file", "desktop.production"],
    "objectTypes": ["bond", "atom", "molecule"],
    "cardinalities": ["1", "many"],
    "states": ["blank-document", "terminal-carbon-hidden", "terminal-carbon-shown", "nonterminal-carbon-hidden", "nonterminal-carbon-shown", "undo", "redo", "saved-document"],
    "inputModes": ["mouse", "right-mouse", "keyboard", "native-dialog"],
    "properties": ["atom.show-terminal-carbon-label", "atom.show-non-terminal-carbon-label", "atom.num-hydrogens", "atom.label-text"],
    "persistenceBoundaries": ["runtime", "history", "filesystem", "native-dialog"]
  }
}
