{
  "schema": "chemsema.gui.scenario.v1",
  "id": "core.arrow.property-matrix-persistence.production",
  "title": "Edit the public arrow property matrix on two objects and verify the saved CCJS",
  "risk": "critical",
  "owner": "editor-core",
  "originatingDefect": "Existing-arrow variant, size, curve, and no-go controls were not reachable without leaving selection mode, while full-state updates could overwrite unrelated endpoints and color.",
  "capabilities": ["gui.public-input", "editor.arrow.draw", "editor.arrow.properties", "editor.selection.select-all", "editor.context-menu", "document.save-as", "oracle.document-file", "desktop.production"],
  "drivers": ["production-black-box"],
  "profile": { "pool": "interactive-isolated-worker", "viewport": { "width": 1028, "height": 779 }, "dpi": 96, "locale": "zh-CN", "theme": "light", "runtime": "production" },
  "seed": 16,
  "actions": [
    { "id": "activate-arrow-tool", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Small arrow head", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "dom-count", "selector": "button[data-tool=\"arrow\"].is-active", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "draw-first-arrow", "type": "drag", "target": { "strategy": "automation-id", "value": "viewer-container" }, "button": "left", "from": { "x": 0.32, "y": 0.34 }, "to": { "x": 0.48, "y": 0.34 }, "steps": 8, "completion": { "kind": "dom-distinct-count", "selector": "[data-role=\"document-graphic\"][data-object-id]", "attribute": "data-object-id", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "draw-second-arrow", "type": "drag", "target": { "strategy": "automation-id", "value": "viewer-container" }, "button": "left", "from": { "x": 0.32, "y": 0.58 }, "to": { "x": 0.48, "y": 0.58 }, "steps": 8, "completion": { "kind": "dom-distinct-count", "selector": "[data-role=\"document-graphic\"][data-object-id]", "attribute": "data-object-id", "operator": "eq", "value": 2, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "activate-box-selection", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Box selection", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "dom-count", "selector": "button[data-tool=\"select\"].is-active", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "select-both-arrows", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Control+A", "completion": { "kind": "dom-count", "selector": "[data-layer=\"editor-overlay\"] > *", "operator": "gte", "value": 2, "timeoutMs": 8000 }, "budgetMs": 12000 },

    { "id": "open-arrow-type-menu", "type": "click", "target": { "strategy": "entity-id", "value": "obj_line_1" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-command=\"arrow-property\"][data-canvas-context-value=\"variant:solid\"][aria-checked=\"true\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "expand-arrow-type-menu", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Arrow Type", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"Arrow Type\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "choose-mirrored-curved", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Mirrored Curved", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden])", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 12000 },

    { "id": "open-color-menu", "type": "click", "target": { "strategy": "entity-id", "value": "obj_line_1" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-command=\"arrow-property\"][data-canvas-context-value=\"variant:curved-mirror\"][aria-checked=\"true\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "expand-color-menu", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Color", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"Color\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "choose-red", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Red", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden])", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 12000 },

    { "id": "open-head-size-menu", "type": "click", "target": { "strategy": "entity-id", "value": "obj_line_1" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-command=\"arrow-property\"][data-canvas-context-value=\"headSize:small\"][aria-checked=\"true\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "expand-head-size-menu", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Arrow Head Size", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"Arrow Head Size\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "choose-large-head", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Large", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden])", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 12000 },

    { "id": "open-curve-menu", "type": "click", "target": { "strategy": "entity-id", "value": "obj_line_1" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-command=\"arrow-property\"][data-canvas-context-value=\"headSize:large\"][aria-checked=\"true\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "expand-curve-menu", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Arrow Curve", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"Arrow Curve\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "choose-curve-120", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "120 degrees", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden])", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 12000 },

    { "id": "open-no-go-menu", "type": "click", "target": { "strategy": "entity-id", "value": "obj_line_1" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-command=\"arrow-property\"][data-canvas-context-value=\"curve:120\"][aria-checked=\"true\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "expand-no-go-menu", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "No-Go Mark", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"No-Go Mark\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "choose-double-slash", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Double Slash", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden])", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 12000 },

    { "id": "open-arrowheads-menu", "type": "click", "target": { "strategy": "entity-id", "value": "obj_line_1" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-command=\"arrow-property\"][data-canvas-context-value=\"noGo:hash\"][aria-checked=\"true\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "expand-arrowheads-menu", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Arrowheads", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"Arrowheads\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "choose-tail-left", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Half Arrow at Start Left", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden])", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 12000 },

    { "id": "open-line-style-menu", "type": "click", "target": { "strategy": "entity-id", "value": "obj_line_1" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-command=\"arrow-endpoint\"][data-canvas-context-value=\"tail:left\"][aria-checked=\"true\"]", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "expand-line-style-menu", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Line Style", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [aria-label=\"Line Style\"]:focus", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "choose-bold", "type": "click", "target": { "strategy": "role", "value": "menuitem", "name": "Bold", "scope": { "role": "menu", "name": "Canvas menu" } }, "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden])", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 12000 },

    { "id": "verify-complete-property-menu", "type": "click", "target": { "strategy": "entity-id", "value": "obj_line_1" }, "button": "right", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden]) [data-canvas-context-command=\"arrow-property\"][data-canvas-context-value=\"variant:curved-mirror\"][aria-checked=\"true\"], .canvas-context-menu:not([hidden]) [data-canvas-context-command=\"arrow-property\"][data-canvas-context-value=\"headSize:large\"][aria-checked=\"true\"], .canvas-context-menu:not([hidden]) [data-canvas-context-command=\"arrow-property\"][data-canvas-context-value=\"curve:120\"][aria-checked=\"true\"], .canvas-context-menu:not([hidden]) [data-canvas-context-command=\"arrow-property\"][data-canvas-context-value=\"noGo:hash\"][aria-checked=\"true\"], .canvas-context-menu:not([hidden]) [data-canvas-context-command=\"arrow-endpoint\"][data-canvas-context-value=\"tail:left\"][aria-checked=\"true\"], .canvas-context-menu:not([hidden]) [data-canvas-context-command=\"line-style\"][data-canvas-context-value=\"bold\"][aria-checked=\"true\"], .canvas-context-menu:not([hidden]) [data-canvas-context-command=\"color\"][data-canvas-context-value=\"#ff0000\"][aria-checked=\"true\"]", "operator": "eq", "value": 7, "timeoutMs": 8000 }, "budgetMs": 12000 },
    { "id": "close-property-menu", "type": "key", "target": { "strategy": "automation-id", "value": "viewer-container" }, "key": "Escape", "completion": { "kind": "dom-count", "selector": ".canvas-context-menu:not([hidden])", "operator": "eq", "value": 0, "timeoutMs": 8000 }, "budgetMs": 12000 },

    { "id": "open-save-as-dialog", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Save as" }, "completion": { "kind": "uia-visible", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "timeoutMs": 15000 }, "budgetMs": 25000 },
    { "id": "focus-save-filename", "type": "click", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 25000 },
    { "id": "select-save-filename", "type": "key", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "key": "Control+A", "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 25000 },
    { "id": "type-save-path", "type": "text", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "textSource": "document-output-path", "completion": { "kind": "actionable", "timeoutMs": 8000 }, "budgetMs": 25000 },
    { "id": "confirm-save", "type": "key", "target": { "strategy": "uia-automation-id", "value": "1001", "controlType": "ControlType.Pane", "className": "Edit" }, "key": "Enter", "completion": { "kind": "document-saved", "timeoutMs": 30000 }, "budgetMs": 90000 }
  ],
  "oracles": [
    { "id": "both-arrows-remain", "kind": "dom-distinct-count", "selector": "[data-role=\"document-graphic\"][data-object-id]", "attribute": "data-object-id", "operator": "eq", "value": 2 },
    { "id": "saved-arrow-property-matrix", "kind": "document-arrow-properties", "expected": [
      { "id": "obj_line_1", "kind": "curved-mirror", "curve": 120, "length": 45, "head": "full", "tail": "half-left", "bold": true, "noGo": "hash", "stroke": "#ff0000" },
      { "id": "obj_line_2", "kind": "curved-mirror", "curve": 120, "length": 45, "head": "full", "tail": "half-left", "bold": true, "noGo": "hash", "stroke": "#ff0000" }
    ] },
    { "id": "no-console-errors", "kind": "no-unexpected-diagnostics" }
  ],
  "expectedDiagnostics": [],
  "coverage": {
    "classification": "real-user-path",
    "features": ["editor.arrow.draw", "editor.arrow.properties", "editor.selection.select-all", "editor.context-menu", "document.save-as", "oracle.document-file", "desktop.production"],
    "objectTypes": ["arrow"],
    "cardinalities": ["1", "2"],
    "states": ["solid", "curved-mirror", "small-head", "large-head", "curve-120", "no-go-hash", "half-left-tail", "bold", "red", "saved-document"],
    "inputModes": ["mouse", "right-mouse", "keyboard", "native-dialog"],
    "properties": ["arrow.variant", "arrow.head-size", "arrow.curve", "arrow.no-go", "arrow.endpoint.tail", "arrow.line-style", "arrow.color"],
    "persistenceBoundaries": ["runtime", "filesystem", "native-dialog"]
  }
}
