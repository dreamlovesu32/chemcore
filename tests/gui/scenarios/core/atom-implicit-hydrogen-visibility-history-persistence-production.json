{
  "schema": "chemsema.gui.scenario.v1",
  "id": "core.atom.implicit-hydrogen-visibility-history-persistence.production",
  "title": "Toggle implicit hydrogens through the public atom menu, verify history, and persist the explicit hidden state",
  "risk": "critical",
  "owner": "editor-core",
  "originatingDefect": "Element and charge-symbol evidence did not prove the public Automatic/Hide implicit-hydrogen value domain, its transaction history, or the durable distinction between automatic zero and an explicit zero override.",
  "capabilities": ["gui.public-input", "editor.bond.draw", "editor.atom.element", "editor.atom.implicit-hydrogens", "editor.context-menu", "editor.history.undo-redo", "document.save-as", "oracle.document-file", "desktop.production"],
  "drivers": ["production-black-box"],
  "profile": { "pool": "interactive-isolated-worker", "viewport": { "width": 1028, "height": 779 }, "dpi": 96, "locale": "zh-CN", "theme": "light", "runtime": "production" },
  "seed": 45,
  "actions": [
    { "id": "activate-single-bond-tool", "type": "click", "target": { "strategy": "role", "value": "button", "name": "Single bond", "scope": { "role": "complementary", "name": "Main Drawing Rail" } }, "completion": { "kind": "dom-count", "selector": "button[data-tool=\"bond\"].is-active", "operator": "eq", "value": 1, "timeoutMs": 8000 }, "budgetMs": 30000 },
