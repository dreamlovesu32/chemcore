    "inputModes": ["mouse", "right-mouse", "keyboard", "native-dialog"],
    "properties": ["atom.element", "atom.atomic-number", "atom.charge", "atom.num-hydrogens", "atom.num-hydrogens-override", "atom.label-text"],
    "persistenceBoundaries": ["runtime", "history", "filesystem", "native-dialog"]
  }
