{
  "schema": "chemsema.gui.scenario.v1",
  "id": "core.atom.radical-cation-symbol-attachment-persistence.production",
  "title": "Attach a public radical-cation symbol to nitrogen and persist exact charge-radical semantics",
  "risk": "critical",
  "owner": "editor-core",
  "originatingDefect": "Positive and negative charge attachment evidence did not prove that a combined radical-cation applies both deltas, persists node radical state, and preserves exact atom-link provenance.",
