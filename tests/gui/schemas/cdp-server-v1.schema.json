{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemsema.gui.cdp-server.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "processId", "sessionId", "account", "port"],
  "properties": {
    "schema": { "const": "chemsema.gui.cdp-server.v1" },
    "status": { "const": "ready" },
    "processId": { "type": "integer", "minimum": 1 },
    "sessionId": { "type": "integer", "minimum": 0 },
    "account": { "type": "string", "minLength": 3 },
    "port": { "const": 9223 }
  }
}
