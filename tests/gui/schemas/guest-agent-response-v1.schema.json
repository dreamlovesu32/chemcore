{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemsema.org/schemas/gui/guest-agent-response-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "status"],
  "properties": {
    "schema": { "const": "chemsema.gui.guest-agent-response.v1" },
    "id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "failed"] },
    "result": { "type": "object" },
    "message": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "passed" } } }, "then": { "required": ["result"] } },
    { "if": { "properties": { "status": { "const": "failed" } } }, "then": { "required": ["message"] } }
  ]
}
