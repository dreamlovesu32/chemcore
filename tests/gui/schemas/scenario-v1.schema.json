{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemsema.org/schemas/gui/scenario-v1.schema.json",
  "title": "ChemSema GUI Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "risk", "owner", "capabilities", "drivers", "profile", "actions", "oracles", "coverage"],
  "properties": {
    "schema": { "const": "chemsema.gui.scenario.v1" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["critical", "high", "medium", "low"] },
    "owner": { "type": "string", "minLength": 1 },
    "originatingDefect": { "type": ["string", "null"] },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["fake", "playwright-browser", "playwright-webview2", "wdio-tauri", "windows-uia", "production-black-box"] }
    },
    "profile": { "$ref": "#/$defs/profile" },
    "seed": { "type": "integer", "minimum": 0 },
    "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } },
    "oracles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/oracle" } },
    "expectedDiagnostics": { "type": "array", "default": [], "items": { "type": "string" } },
    "coverage": { "$ref": "#/$defs/coverage" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool", "viewport", "dpi", "locale", "theme", "runtime"],
      "properties": {
        "pool": { "enum": ["background-worker", "interactive-isolated-worker"] },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 320 },
            "height": { "type": "integer", "minimum": 240 }
          }
        },
        "dpi": { "type": "integer", "minimum": 96, "maximum": 480 },
        "locale": { "type": "string", "minLength": 2 },
        "theme": { "enum": ["light", "dark", "system"] },
        "runtime": { "enum": ["browser", "webview2", "tauri-test", "production"] }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "value"],
      "properties": {
        "strategy": { "enum": ["role", "automation-id", "test-id", "entity-id", "world-geometry", "uia-automation-id"] },
        "value": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "controlType": { "type": "string", "pattern": "^ControlType\\.[A-Za-z]+$" },
        "className": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "name"],
          "properties": {
            "role": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "strategy": { "const": "uia-automation-id" } } },
          "then": { "required": ["controlType", "className"] }
        }
      ]
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "timeoutMs"],
      "properties": {
        "kind": { "enum": ["actionable", "dom-count", "dom-distinct-count", "entity-rect-deltas", "quiescent", "uia-visible", "document-saved"] },
        "target": { "$ref": "#/$defs/target" },
        "selector": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "attribute": { "enum": ["data-object-id", "data-node-id", "data-bond-id"] },
        "entities": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["entityId", "operator", "toleranceWorld"],
            "properties": {
              "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "operator": { "enum": ["stationary", "moved"] },
              "toleranceWorld": { "type": "number", "minimum": 0, "maximum": 1000 }
            }
          }
        },
        "operator": { "enum": ["eq", "gte"] },
        "value": { "type": "integer", "minimum": 0 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["dom-count", "dom-distinct-count"] } } },
          "then": { "required": ["selector", "operator", "value"] }
        },
        {
          "if": { "properties": { "kind": { "const": "dom-distinct-count" } } },
          "then": { "required": ["attribute"] }
        },
        {
          "if": { "properties": { "kind": { "const": "uia-visible" } } },
          "then": { "required": ["target"] }
        },
        {
          "if": { "properties": { "kind": { "const": "entity-rect-deltas" } } },
          "then": { "required": ["entities"] }
        },
        {
          "if": { "properties": { "kind": { "enum": ["actionable", "quiescent", "document-saved"] } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["target"] },
                { "required": ["selector"] },
                { "required": ["attribute"] },
                { "required": ["operator"] },
                { "required": ["value"] }
              ]
            }
          }
        }
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "target", "completion", "budgetMs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["click", "drag", "key", "text"] },
        "target": { "$ref": "#/$defs/target" },
        "button": { "enum": ["left", "right", "middle"] },
        "modifiers": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "enum": ["Shift", "Control", "Alt"] } },
        "from": { "$ref": "#/$defs/point" },
        "to": { "$ref": "#/$defs/point" },
        "at": { "$ref": "#/$defs/point" },
        "steps": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "key": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "textSource": { "enum": ["document-output-path"] },
        "completion": { "$ref": "#/$defs/completion" },
        "budgetMs": { "type": "integer", "minimum": 30000, "maximum": 300000 },
        "fakeEffect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "selector", "by"],
          "properties": {
            "kind": { "const": "increment-dom-count" },
            "selector": { "type": "string", "minLength": 1 },
            "by": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "drag" } } }, "then": { "required": ["from", "to", "steps"] } },
        { "if": { "properties": { "type": { "const": "key" } } }, "then": { "required": ["key"] } },
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": {
            "oneOf": [
              { "required": ["text"], "not": { "required": ["textSource"] } },
              { "required": ["textSource"], "not": { "required": ["text"] } }
            ]
          }
        },
        { "if": { "properties": { "type": { "enum": ["click", "drag"] } } }, "else": { "not": { "required": ["modifiers"] } } },
        { "if": { "properties": { "type": { "const": "click" } } }, "else": { "not": { "required": ["at"] } } },
        {
          "if": { "properties": { "completion": { "type": "object", "properties": { "kind": { "const": "document-saved" } }, "required": ["kind"] } } },
          "then": { "properties": { "budgetMs": { "type": "integer", "minimum": 90000 } } }
        }
      ]
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["dom-count", "dom-distinct-count", "no-unexpected-diagnostics", "document-counts", "document-arrow-properties", "document-text-properties"] },
        "selector": { "type": "string" },
        "attribute": { "enum": ["data-object-id", "data-node-id", "data-bond-id"] },
        "operator": { "enum": ["eq", "gte"] },
        "value": { "type": "integer", "minimum": 0 },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["nodes", "bonds", "molecules", "objects"],
              "properties": {
                "nodes": { "type": "integer", "minimum": 0 },
                "bonds": { "type": "integer", "minimum": 0 },
                "molecules": { "type": "integer", "minimum": 0 },
                "objects": { "type": "integer", "minimum": 0 }
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id"],
                "minProperties": 2,
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "kind": { "enum": ["solid", "curved", "curved-mirror", "hollow", "open", "equilibrium", "unequal-equilibrium"] },
                  "curve": { "type": "number", "minimum": -360, "maximum": 360 },
                  "length": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
                  "head": { "enum": ["none", "full", "half-left", "half-right"] },
                  "tail": { "enum": ["none", "full", "half-left", "half-right"] },
                  "bold": { "type": "boolean" },
                  "noGo": { "enum": ["none", "cross", "hash"] },
                  "stroke": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
                }
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "text"],
                "minProperties": 3,
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "text": { "type": "string", "maxLength": 4096 },
                  "fontFamily": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "fontSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
                  "align": { "enum": ["left", "center", "right", "justify"] },
                  "bold": { "type": "boolean" },
                  "fill": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["dom-count", "dom-distinct-count"] } } },
          "then": { "required": ["selector", "operator", "value"] }
        },
        {
          "if": { "properties": { "kind": { "const": "dom-distinct-count" } } },
          "then": { "required": ["attribute"] }
        },
        {
          "if": { "properties": { "kind": { "const": "document-counts" } } },
          "then": { "required": ["expected"] }
        },
        {
          "if": { "properties": { "kind": { "const": "document-arrow-properties" } } },
          "then": { "required": ["expected"] }
        },
        {
          "if": { "properties": { "kind": { "const": "document-text-properties" } } },
          "then": { "required": ["expected"] }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "features", "objectTypes", "cardinalities", "states", "inputModes", "properties", "persistenceBoundaries"],
      "properties": {
        "classification": { "enum": ["real-user-path", "setup-only", "oracle-only"] },
        "features": { "$ref": "#/$defs/nonEmptyIds" },
        "objectTypes": { "$ref": "#/$defs/nonEmptyIds" },
        "cardinalities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["0", "1", "2", "many"] } },
        "states": { "$ref": "#/$defs/nonEmptyIds" },
        "inputModes": { "$ref": "#/$defs/nonEmptyIds" },
        "properties": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "persistenceBoundaries": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "nonEmptyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  }
}
