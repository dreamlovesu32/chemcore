{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemsema.org/schemas/gui/scenario-v1.schema.json",
  "title": "ChemSema GUI Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "risk", "owner", "capabilities", "drivers", "profile", "actions", "oracles", "coverage"],
  "properties": {
    "schema": { "const": "chemsema.gui.scenario.v1" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["critical", "high", "medium", "low"] },
    "owner": { "type": "string", "minLength": 1 },
    "originatingDefect": { "type": ["string", "null"] },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["fake", "playwright-browser", "playwright-webview2", "wdio-tauri", "windows-uia", "production-black-box"] }
    },
    "profile": { "$ref": "#/$defs/profile" },
    "seed": { "type": "integer", "minimum": 0 },
    "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } },
    "oracles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/oracle" } },
    "expectedDiagnostics": { "type": "array", "default": [], "items": { "type": "string" } },
    "coverage": { "$ref": "#/$defs/coverage" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool", "viewport", "dpi", "locale", "theme", "runtime"],
      "properties": {
        "pool": { "enum": ["background-worker", "interactive-isolated-worker"] },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 320 },
            "height": { "type": "integer", "minimum": 240 }
          }
        },
        "dpi": { "type": "integer", "minimum": 96, "maximum": 480 },
        "locale": { "type": "string", "minLength": 2 },
        "theme": { "enum": ["light", "dark", "system"] },
        "runtime": { "enum": ["browser", "webview2", "tauri-test", "production"] }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "value"],
      "properties": {
        "strategy": { "enum": ["role", "automation-id", "test-id", "selector", "entity-id", "world-geometry", "uia-automation-id"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "name": { "type": "string" },
        "controlType": { "type": "string", "pattern": "^ControlType\\.[A-Za-z]+$" },
        "className": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "name"],
          "properties": {
            "role": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "strategy": { "const": "uia-automation-id" } } },
          "then": { "required": ["controlType", "className"] }
        }
      ]
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "timeoutMs"],
      "properties": {
        "kind": { "enum": ["actionable", "dom-count", "dom-distinct-count", "dom-text", "entity-rect-deltas", "quiescent", "uia-visible", "document-saved"] },
        "target": { "$ref": "#/$defs/target" },
        "selector": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "attribute": { "enum": ["data-object-id", "data-node-id", "data-bond-id"] },
        "entities": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["entityId", "operator", "toleranceWorld"],
            "properties": {
              "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "operator": { "enum": ["stationary", "moved"] },
              "toleranceWorld": { "type": "number", "minimum": 0, "maximum": 1000 }
            }
          }
        },
        "operator": { "enum": ["eq", "gte"] },
        "value": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "maxLength": 4096 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["dom-count", "dom-distinct-count"] } } },
          "then": { "required": ["selector", "operator", "value"] }
        },
        {
          "if": { "properties": { "kind": { "const": "dom-distinct-count" } } },
          "then": { "required": ["attribute"] }
        },
        {
          "if": { "properties": { "kind": { "const": "dom-text" } } },
          "then": {
            "required": ["selector", "text"],
            "not": {
              "anyOf": [
                { "required": ["target"] },
                { "required": ["attribute"] },
                { "required": ["entities"] },
                { "required": ["operator"] },
                { "required": ["value"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "uia-visible" } } },
          "then": { "required": ["target"] }
        },
        {
          "if": { "properties": { "kind": { "const": "entity-rect-deltas" } } },
          "then": { "required": ["entities"] }
        },
        {
          "if": { "properties": { "kind": { "enum": ["actionable", "quiescent", "document-saved"] } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["target"] },
                { "required": ["selector"] },
                { "required": ["attribute"] },
                { "required": ["operator"] },
                { "required": ["value"] },
                { "required": ["text"] }
              ]
            }
          }
        }
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "target", "completion", "budgetMs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["click", "drag", "key", "text"] },
        "target": { "$ref": "#/$defs/target" },
        "button": { "enum": ["left", "right", "middle"] },
        "modifiers": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "enum": ["Shift", "Control", "Alt"] } },
        "from": { "$ref": "#/$defs/point" },
        "to": { "$ref": "#/$defs/point" },
        "at": { "$ref": "#/$defs/point" },
        "steps": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "key": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "textSource": { "enum": ["document-output-path"] },
        "replaceExisting": { "type": "boolean" },
        "completion": { "$ref": "#/$defs/completion" },
        "budgetMs": { "type": "integer", "minimum": 30000, "maximum": 300000 },
        "fakeEffect": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "selector", "by"],
              "properties": {
                "kind": { "const": "increment-dom-count" },
                "selector": { "type": "string", "minLength": 1, "maxLength": 2048 },
                "by": { "type": "integer", "minimum": 1 }
              }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "selector", "text"],
              "properties": {
                "kind": { "const": "set-dom-text" },
                "selector": { "type": "string", "minLength": 1, "maxLength": 2048 },
                "text": { "type": "string", "maxLength": 4096 }
              }
            }
          ]
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "drag" } } }, "then": { "required": ["from", "to", "steps"] } },
        { "if": { "properties": { "type": { "const": "key" } } }, "then": { "required": ["key"] } },
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": {
            "oneOf": [
              { "required": ["text"], "not": { "required": ["textSource"] } },
              { "required": ["textSource"], "not": { "required": ["text"] } }
            ]
          }
        },
        { "if": { "properties": { "type": { "const": "text" } } }, "else": { "not": { "required": ["replaceExisting"] } } },
        { "if": { "properties": { "type": { "enum": ["click", "drag"] } } }, "else": { "not": { "required": ["modifiers"] } } },
        { "if": { "properties": { "type": { "const": "click" } } }, "else": { "not": { "required": ["at"] } } },
        {
          "if": { "properties": { "completion": { "type": "object", "properties": { "kind": { "const": "document-saved" } }, "required": ["kind"] } } },
          "then": { "properties": { "budgetMs": { "type": "integer", "minimum": 90000 } } }
        }
      ]
    },
    "uiExpected": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "count": { "type": "integer", "minimum": 0, "maximum": 128 },
        "visibleCount": { "type": "integer", "minimum": 0, "maximum": 128 },
        "focusedCount": { "type": "integer", "minimum": 0, "maximum": 128 },
        "focusWithinCount": { "type": "integer", "minimum": 0, "maximum": 128 },
        "hoverCount": { "type": "integer", "minimum": 0, "maximum": 128 },
        "disabledCount": { "type": "integer", "minimum": 0, "maximum": 128 },
        "styles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["property", "operator", "value"],
            "properties": {
              "property": { "enum": ["backgroundColor", "borderColor", "boxShadow", "cursor", "display", "fill", "opacity", "outlineColor", "outlineStyle", "outlineWidth", "pointerEvents", "stroke", "strokeWidth", "visibility"] },
              "operator": { "enum": ["eq", "neq", "contains"] },
              "value": { "type": "string", "maxLength": 256 }
            }
          }
        },
        "rect": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "minWidth": { "type": "number", "minimum": 0, "maximum": 100000 },
            "maxWidth": { "type": "number", "minimum": 0, "maximum": 100000 },
            "minHeight": { "type": "number", "minimum": 0, "maximum": 100000 },
            "maxHeight": { "type": "number", "minimum": 0, "maximum": 100000 }
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relation", "tolerancePx"],
          "properties": {
            "relation": { "enum": ["matches-reference", "contains-reference", "inside-reference", "overlaps-reference"] },
            "tolerancePx": { "type": "number", "minimum": 0, "maximum": 256 }
          }
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "devicePixelRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
            "minWidth": { "type": "integer", "minimum": 1, "maximum": 32768 },
            "maxWidth": { "type": "integer", "minimum": 1, "maximum": 32768 },
            "minHeight": { "type": "integer", "minimum": 1, "maximum": 32768 },
            "maxHeight": { "type": "integer", "minimum": 1, "maximum": 32768 }
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["dom-count", "dom-distinct-count", "ui-state", "no-unexpected-diagnostics", "document-counts", "document-bond-properties", "document-node-properties", "document-arrow-properties", "document-text-properties", "document-shape-properties", "document-orbital-properties", "document-chromatography-properties", "document-symbol-properties", "document-bracket-properties", "document-table-properties"] },
        "selector": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "referenceSelector": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "uiExpected": { "$ref": "#/$defs/uiExpected" },
        "attribute": { "enum": ["data-object-id", "data-node-id", "data-bond-id"] },
        "operator": { "enum": ["eq", "gte"] },
        "value": { "type": "integer", "minimum": 0 },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["nodes", "bonds", "molecules", "objects"],
              "properties": {
                "nodes": { "type": "integer", "minimum": 0 },
                "bonds": { "type": "integer", "minimum": 0 },
                "molecules": { "type": "integer", "minimum": 0 },
                "objects": { "type": "integer", "minimum": 0 }
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "element", "atomicNumber", "charge", "labelText", "labelSourceText"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "element": { "type": "string", "minLength": 1, "maxLength": 3 },
                  "atomicNumber": { "type": "integer", "minimum": 1, "maximum": 118 },
                  "charge": { "type": "integer", "minimum": -16, "maximum": 16 },
                  "numHydrogens": { "type": "integer", "minimum": 0, "maximum": 32 },
                  "numHydrogensOverride": { "type": "integer", "minimum": 0, "maximum": 32 },
                  "radicalCount": { "type": "integer", "minimum": 0, "maximum": 16 },
                  "isotopeMass": { "type": "integer", "minimum": 1, "maximum": 32767 },
                  "isotopicAbundance": { "enum": ["unspecified", "any", "natural", "enriched", "deficient", "nonnatural"] },
                  "atomRadical": { "enum": ["none", "singlet", "doublet", "triplet"] },
                  "atomNumber": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "showAtomNumber": { "type": "boolean" },
                  "atomStereo": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "showAtomStereo": { "type": "boolean" },
                  "reactionChange": { "type": "boolean" },
                  "reactionStereo": { "enum": ["unspecified", "inversion", "retention"] },
                  "showAtomQuery": { "type": "boolean" },
                  "ringBondCount": { "enum": ["unspecified", "no-ring-bonds", "as-drawn", "simple-ring", "fusion", "spiro-or-higher"] },
                  "labelText": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "labelSourceText": { "type": "string", "minLength": 1, "maxLength": 128 }
                }
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "order", "mainLineStyle", "leftLineStyle", "rightLineStyle", "mainLineWeight", "stereoKind", "wideEnd"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "order": { "type": "integer", "minimum": 1, "maximum": 3 },
                  "mainLineStyle": { "enum": ["solid", "dashed", "hash", "wavy"] },
                  "leftLineStyle": { "enum": ["solid", "dashed", "hash", "wavy"] },
                  "rightLineStyle": { "enum": ["solid", "dashed", "hash", "wavy"] },
                  "mainLineWeight": { "enum": ["normal", "bold"] },
                  "doublePlacement": { "type": ["string", "null"], "enum": [null, "left", "right", "center"] },
                  "stereoKind": { "type": ["string", "null"], "enum": [null, "solid-wedge", "hashed-wedge", "hollow-wedge"] },
                  "wideEnd": { "type": ["string", "null"], "enum": [null, "begin", "end"] },
                  "queryOrders": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 4,
                    "uniqueItems": true,
                    "items": { "enum": ["single", "aromatic", "double", "triple"] }
                  },
                  "topology": { "enum": ["unspecified", "ring", "chain", "ring-or-chain"] },
                  "reactionParticipation": { "enum": ["unspecified", "reaction-center", "make-or-break", "change-type", "make-and-change", "not-reaction-center", "no-change", "unmapped"] },
                  "absoluteStereo": { "enum": ["unspecified", "none", "e", "z"] },
                  "showQuery": { "type": ["boolean", "null"] },
                  "showReaction": { "type": ["boolean", "null"] },
                  "showStereo": { "type": ["boolean", "null"] }
                }
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id"],
                "minProperties": 2,
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "kind": { "enum": ["solid", "curved", "curved-mirror", "hollow", "open", "equilibrium", "unequal-equilibrium"] },
                  "curve": { "type": "number", "minimum": -360, "maximum": 360 },
                  "length": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
                  "head": { "enum": ["none", "full", "half-left", "half-right"] },
                  "tail": { "enum": ["none", "full", "half-left", "half-right"] },
                  "bold": { "type": "boolean" },
                  "noGo": { "enum": ["none", "cross", "hash"] },
                  "stroke": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
                }
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "text"],
                "minProperties": 3,
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "text": { "type": "string", "maxLength": 4096 },
                  "fontFamily": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "fontSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
                  "align": { "enum": ["left", "center", "right", "justify"] },
                  "lineHeight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
                  "lineHeightMode": { "enum": ["fixed", "auto"] },
                  "bold": { "type": "boolean" },
                  "italic": { "type": "boolean" },
                  "underline": { "type": "boolean" },
                  "outline": { "type": "boolean" },
                  "shadow": { "type": "boolean" },
                  "script": { "enum": ["normal", "chemical", "subscript", "superscript"] },
                  "fill": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
                }
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind"],
                "minProperties": 3,
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "kind": { "enum": ["circle", "ellipse", "roundRect", "rect"] },
                  "fill": { "type": ["string", "null"], "pattern": "^#[0-9a-fA-F]{6}$" },
                  "stroke": { "type": ["string", "null"], "pattern": "^#[0-9a-fA-F]{6}$" },
                  "strokeWidth": { "type": "number", "minimum": 0, "maximum": 1000 },
                  "dashArray": { "type": "array", "maxItems": 16, "items": { "type": "number", "minimum": 0, "maximum": 1000 } },
                  "shaded": { "type": "boolean" },
                  "shadow": { "type": "boolean" },
                  "shadowSize": { "type": ["number", "null"], "minimum": 0, "maximum": 1000 }
                }
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "template", "orbitalStyle", "phase", "color", "geometryValid", "fill", "stroke", "strokeWidth", "dashArray", "shaded"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "kind": { "const": "orbital" },
                  "template": { "enum": ["s", "oval", "lobe", "p", "dxy", "hybrid", "dz2"] },
                  "orbitalStyle": { "enum": ["hollow", "filled", "shaded"] },
                  "phase": { "enum": ["plus", "minus"] },
                  "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
                  "geometryValid": { "const": true },
                  "axisLength": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
                  "bboxSize": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 } },
                  "angle": { "type": "number", "minimum": -360, "maximum": 360 },
                  "fill": { "type": ["string", "null"], "pattern": "^#[0-9a-fA-F]{6}$" },
                  "stroke": { "type": ["string", "null"], "pattern": "^#[0-9a-fA-F]{6}$" },
                  "strokeWidth": { "type": "number", "minimum": 0, "maximum": 1000 },
                  "dashArray": { "type": "array", "maxItems": 16, "items": { "type": "number", "minimum": 0, "maximum": 1000 } },
                  "shaded": { "type": "boolean" }
                }
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "laneCount", "firstMarkValues", "color"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "kind": { "enum": ["tlcPlate", "gelPlate"] },
                  "laneCount": { "type": "integer", "minimum": 1, "maximum": 128 },
                  "firstMarkValues": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "number" } },
                  "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
                  "showOrigin": { "type": "boolean" },
                  "showSolventFront": { "type": "boolean" },
                  "showBorders": { "type": "boolean" },
                  "showSideTicks": { "type": "boolean" }
                },
                "allOf": [{
                  "if": { "properties": { "kind": { "const": "tlcPlate" } } },
                  "then": { "required": ["showOrigin", "showSolventFront", "showBorders", "showSideTicks"] },
                  "else": { "not": { "anyOf": [{ "required": ["showOrigin"] }, { "required": ["showSolventFront"] }, { "required": ["showBorders"] }, { "required": ["showSideTicks"] }] } }
                }]
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind"],
                "minProperties": 3,
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "kind": { "enum": ["circle-plus", "plus", "radical-cation", "lone-pair", "circle-minus", "minus", "radical-anion", "electron"] },
                  "payloadFill": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
                  "styleFill": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
                  "styleKind": { "const": "symbol" },
                  "symbolStyle": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "chemicalRole": { "enum": ["charge", "radical", "radical-cation", "radical-anion", "lone-pair"] },
                  "chargeDelta": { "type": "integer", "minimum": -16, "maximum": 16 },
                  "radicalDelta": { "type": "integer", "minimum": 0, "maximum": 16 },
                  "attachedAtomId": { "$ref": "#/$defs/id" },
                  "attachmentSource": { "enum": ["auto", "explicit", "source"] }
                }
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "children"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "children": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "kind", "side", "stroke"],
                      "properties": {
                        "id": { "$ref": "#/$defs/id" },
                        "kind": { "enum": ["round", "square", "curly"] },
                        "side": { "enum": ["left", "right"] },
                        "stroke": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "rows", "columns", "cells"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "rows": { "type": "integer", "minimum": 1, "maximum": 100 },
                  "columns": { "type": "integer", "minimum": 1, "maximum": 100 },
                  "cells": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 128,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["row", "column", "horizontalAlignment", "verticalAlignment", "borders"],
                      "properties": {
                        "row": { "type": "integer", "minimum": 0, "maximum": 99 },
                        "column": { "type": "integer", "minimum": 0, "maximum": 99 },
                        "horizontalAlignment": { "enum": ["left", "center", "right"] },
                        "verticalAlignment": { "enum": ["top", "middle", "bottom"] },
                        "borders": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "top": { "$ref": "#/$defs/tableBorder" },
                            "left": { "$ref": "#/$defs/tableBorder" },
                            "bottom": { "$ref": "#/$defs/tableBorder" },
                            "right": { "$ref": "#/$defs/tableBorder" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["dom-count", "dom-distinct-count"] } } },
          "then": { "required": ["selector", "operator", "value"] }
        },
        {
          "if": { "properties": { "kind": { "const": "dom-distinct-count" } } },
          "then": { "required": ["attribute"] }
        },
        {
          "if": { "properties": { "kind": { "const": "ui-state" } } },
          "then": { "required": ["selector", "uiExpected"] }
        },
        {
          "if": { "properties": { "kind": { "const": "document-counts" } } },
          "then": { "required": ["expected"] }
        },
        {
          "if": { "properties": { "kind": { "const": "document-bond-properties" } } },
          "then": { "required": ["expected"] }
        },
        {
          "if": { "properties": { "kind": { "const": "document-node-properties" } } },
          "then": { "required": ["expected"] }
        },
        {
          "if": { "properties": { "kind": { "const": "document-arrow-properties" } } },
          "then": { "required": ["expected"] }
        },
        {
          "if": { "properties": { "kind": { "const": "document-text-properties" } } },
          "then": { "required": ["expected"] }
        },
        {
          "if": { "properties": { "kind": { "const": "document-shape-properties" } } },
          "then": { "required": ["expected"] }
        },
        {
          "if": { "properties": { "kind": { "const": "document-orbital-properties" } } },
          "then": { "required": ["expected"] }
        },
        {
          "if": { "properties": { "kind": { "const": "document-chromatography-properties" } } },
          "then": { "required": ["expected"] }
        },
        {
          "if": { "properties": { "kind": { "const": "document-symbol-properties" } } },
          "then": { "required": ["expected"] }
        },
        {
          "if": { "properties": { "kind": { "const": "document-bracket-properties" } } },
          "then": { "required": ["expected"] }
        },
        {
          "if": { "properties": { "kind": { "const": "document-table-properties" } } },
          "then": { "required": ["expected"] }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "features", "objectTypes", "cardinalities", "states", "inputModes", "properties", "persistenceBoundaries"],
      "properties": {
        "classification": { "enum": ["real-user-path", "setup-only", "oracle-only"] },
        "features": { "$ref": "#/$defs/nonEmptyIds" },
        "objectTypes": { "$ref": "#/$defs/nonEmptyIds" },
        "cardinalities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["0", "1", "2", "many"] } },
        "states": { "$ref": "#/$defs/nonEmptyIds" },
        "inputModes": { "$ref": "#/$defs/nonEmptyIds" },
        "properties": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "persistenceBoundaries": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "nonEmptyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "tableBorder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "lineStyle", "width", "color"],
      "properties": {
        "visible": { "type": "boolean" },
        "lineStyle": { "enum": ["solid", "dashed", "bold", "wavy"] },
        "width": { "type": "number", "minimum": 0, "maximum": 1000 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    }
  }
}
