{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemsema.org/schemas/gui/worker-profile-v1.schema.json",
  "title": "ChemSema GUI Worker Profile v1",
  "oneOf": [
    { "$ref": "#/$defs/hyperV" },
    { "$ref": "#/$defs/physicalWindows" }
  ],
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuUnits", "memoryGiB"],
      "properties": {
        "cpuUnits": { "type": "integer", "minimum": 1, "maximum": 64 },
        "memoryGiB": { "type": "integer", "minimum": 1, "maximum": 512 }
      }
    },
    "hyperV": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "kind", "vm", "resources", "credential", "guest", "isolation"],
      "properties": {
        "schema": { "const": "chemsema.gui.worker-profile.v1" },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "kind": { "const": "hyper-v" },
        "vm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "generation", "checkpoint"],
          "properties": {
            "id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
            "generation": { "const": 2 },
            "checkpoint": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
                "name": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "resources": { "$ref": "#/$defs/resources" },
        "credential": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pathTemplate"],
          "properties": { "pathTemplate": { "type": "string", "minLength": 1 } }
        },
        "guest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["account", "testRoot"],
          "properties": {
            "account": { "type": "string", "minLength": 1 },
            "testRoot": { "type": "string", "pattern": "^[A-Za-z]:\\\\" }
          }
        },
        "isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostInput", "hostClipboard", "hostProjectMount", "interactiveDesktopExclusive"],
          "properties": {
            "hostInput": { "const": false },
            "hostClipboard": { "const": false },
            "hostProjectMount": { "const": false },
            "interactiveDesktopExclusive": { "const": true }
          }
        }
      }
    },
    "physicalWindows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "kind", "machine", "resources", "account", "testRootTemplate", "isolation"],
      "properties": {
        "schema": { "const": "chemsema.gui.worker-profile.v1" },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "kind": { "const": "physical-windows" },
        "machine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["computerName", "machineIdSha256"],
          "properties": {
            "computerName": { "type": "string", "minLength": 1, "maxLength": 63 },
            "machineIdSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "resources": { "$ref": "#/$defs/resources" },
        "account": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "sessionId"],
          "properties": {
            "name": { "type": "string", "pattern": "^[^\\\\]+\\\\[^\\\\]+$" },
            "sessionId": { "type": "integer", "minimum": 1 }
          }
        },
        "testRootTemplate": { "type": "string", "minLength": 1 },
        "isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dedicatedPhysicalMachine", "hostInput", "hostClipboard", "hostProjectMount", "interactiveDesktopExclusive"],
          "properties": {
            "dedicatedPhysicalMachine": { "const": true },
            "hostInput": { "const": true },
            "hostClipboard": { "const": true },
            "hostProjectMount": { "const": false },
            "interactiveDesktopExclusive": { "const": true }
          }
        }
      }
    }
  }
}
