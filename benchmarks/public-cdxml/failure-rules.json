    {
      "id": "cdxml-bind-anonymous-object-tag-text",
      "status": "verified",
      "summary": "An ObjectTag child Text without its own CDX object ID remains linked to the tag by owner, semantic role, and content. Automatic enhanced-stereo placement preserves the cached direction vector separately from the rendered text box.",
      "officialRule": "Object IDs may be unassigned when an object is not referenced. ObjectTag is the owning metadata object, and PositioningType=auto interprets the cached child geometry as positioning input. Attachment is a relation, not the child object's identity, so it must not make the owner's source ID ambiguous.",
      "evidence": [
        "https://iupac.github.io/IUPAC-FAIRSpec/cdx_sdk/IntroCDX.htm",
        "https://iupac.github.io/IUPAC-FAIRSpec/cdx_sdk/AllCDXObjects.htm",
        "docs/cdxml-text-label-field-audit.zh-CN.md",
        "crates/chemsema-engine/src/cdxml/import_logical_objects.rs#anonymous_object_tag_text_binds_by_owner_role_and_content"
      ],
      "caseIds": [
        "0030",
