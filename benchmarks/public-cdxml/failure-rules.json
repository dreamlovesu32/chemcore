    {
      "id": "cdxml-preserve-invisible-text-objects",
      "status": "verified",
      "summary": "A CDX/CDXML Text object with Visible=no remains an editable object across export and reimport; visibility controls rendering and does not delete the object.",
      "officialRule": "CDX object ID zero means no ID was assigned and is permitted for an unreferenced object. The independent Visible property controls whether an object is displayed. Therefore neither an unassigned ID nor Visible=no permits dropping the Text object from the document.",
      "evidence": [
        "https://iupac.github.io/IUPAC-FAIRSpec/cdx_sdk/IntroCDX.htm",
        "https://iupac.github.io/IUPAC-FAIRSpec/cdx_sdk/TableOfProperties.htm",
        "crates/chemsema-engine/src/cdx.rs#cdx_unassigned_invisible_text_remains_an_invisible_object_after_export"
      ],
