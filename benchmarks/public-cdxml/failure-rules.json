    {
      "id": "cdxml-keep-automatic-node-labels-derived",
      "status": "verified",
      "summary": "Atom, query-list, and carbon-display labels generated from node properties remain derived on CDX/CDXML export. ChemSema emits a child Text object only after the label text becomes explicit.",
      "officialRule": "Element and ElementList are Node properties, while ShowTerminalCarbonLabels and ShowNonTerminalCarbonLabels control whether carbon labels are displayed. A Text object is a separate arbitrary text block, so an unchanged property-derived node display must not be materialized as authored text.",
